#ifndef _LIBKPP_UTILITY
#define _LIBKPP_UTILITY 1

#include <type_traits>

/********************************************************************************************************************/

namespace std
{
    template <class T>
    remove_reference_t<T>&& move(T &t) noexcept
    {
        typedef remove_reference_t<T> _up;
        return static_cast<_up&&>(t);
    }

    template <class T>
    remove_reference_t<T>&& move(T&& t) noexcept 
    {
        typedef remove_reference_t<T> _up;
        return static_cast<_up&&>(t);
    }

    template <class T>
    T&& forward(remove_reference_t<T> &t) noexcept
    {
        return static_cast<T&&>(t);
    }

    template <class T>
    T&& forward(remove_reference_t<T> &&t) noexcept
    {
        static_assert(!std::is_lvalue_reference_v<T>,
            "std::forward: cannot forward an rvalue as an lvalue");

        return static_cast<T&&>(t);
    }

    template <class T>
    inline void swap(T &x, T &y) noexcept
    {
        T tmp = move(x);
        x = move(y);
        y = move(tmp);
    }

    template <typename T>
    constexpr underlying_type_t<T> to_underlying(T e) noexcept
    {
        return static_cast<std::underlying_type_t<T>>(e);
    }

    template <class T>
    constexpr add_const_t<T> &as_const(T& t) noexcept
    {
        return t;
    }

    template <typename T>
    typename std::type_identity_t<T> declval() noexcept
    {
        static_assert(false, "Do not call into declval()");
    }
}

/********************************************************************************************************************/

#endif /* _LIBKPP_UTILITY */

