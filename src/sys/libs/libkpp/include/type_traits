#ifndef _LIBKPP_TYPE_TRAITS
#define _LIBKPP_TYPE_TRAITS 1

/********************************************************************************************************************/

namespace std
{
    template <class T>
    struct type_identity { using type = T; };

    template <class T>
    using type_identity_t = type_identity<T>::type;

    // Integral is needed for almost all other checks.
    #include <cppimpl/type_traits/integral.h>
    #include <cppimpl/type_traits/fp.h>
    #include <cppimpl/type_traits/arithmetic.h>
    #include <cppimpl/type_traits/sign.h>
    #include <cppimpl/type_traits/void.h>
    #include <cppimpl/type_traits/enum.h>
    #include <cppimpl/type_traits/ref.h>
    #include <cppimpl/type_traits/cv.h>

    #include <cppimpl/type_traits/pointer.h>

    template <class T, class U>
    struct is_same : std::false_type { };

    template <class T>
    struct is_same<T, T> : std::true_type { };

    template <class T, class U>
    constexpr bool is_same_v = is_same<T, U>::value;

    #include <cppimpl/type_traits/conditional.h>
    #include <cppimpl/type_traits/convertible.h>
    #include <cppimpl/type_traits/enable.h>
}

/********************************************************************************************************************/

#endif /* X_TYPE_TRAITS */

/********************************************************************************************************************/
