#ifndef _X_UTILITY
#define _X_UTILITY 1

#include <type_traits>

/********************************************************************************************************************/

namespace std
{
    template <class T>
    std::remove_reference_t<T>&& move(T &t) noexcept
    {
        typedef std::remove_reference_t<T> _up;
        return static_cast<_up&&>(t);
    }

    template <class T>
    std::remove_reference_t<T>&& move(T&& t) noexcept 
    {
        typedef std::remove_reference_t<T> _up;
        return static_cast<_up&&>(t);
    }

    template <class T>
    T&& forward(std::remove_reference_t<T> &t) noexcept
    {
        return static_cast<T&&>(t);
    }

    template <class T>
    T&& forward(std::remove_reference_t<T> &&t) noexcept
    {
        static_assert(!std::is_lvalue_reference_v<T>,
            "std::forward: cannot forward an rvalue as an lvalue");

        return static_cast<T&&>(t);
    }

    template <class T>
    inline void swap(T &x, T &y) noexcept
    {
        T tmp = std::move(x);
        x = std::move(y);
        y = std::move(tmp);
    }

    template <typename T>
    constexpr std::underlying_type_t<T> to_underlying(T e) noexcept
    {
        return static_cast<std::underlying_type_t<T>>(e);
    }

    template <class T>
    constexpr std::add_const_t<T> &as_const(T& t) noexcept
    {
        return t;
    }
}

/********************************************************************************************************************/

#endif /* _X_UTILITY */

/********************************************************************************************************************/
